Bootstrap: docker
From: nvcr.io/nvidia/pytorch:21.11-py3

%files

    . /opt/DREAMPlace

%post
    set -eux

    apt-get update
	DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libfl-dev \
        libcairo2-dev \
        libboost-all-dev \
        ca-certificates \
        curl \
		bison

    pip install --no-cache-dir \
        "pyunpack>=0.1.2" \
        "patool>=1.12" \
        "matplotlib>=2.2.2" \
        "cairocffi>=0.9.0" \
        "pkgconfig>=1.4.0" \
        "setuptools>=39.1.0" \
        "scipy>=1.1.0" \
        "numpy>=1.15.4" \
        "shapely>=1.7.0"

    cd /opt/DREAMPlace
	python benchmarks/ispd2005_2015.py

    mkdir build
    pip install -r requirements.txt
    cd build
    cmake .. -DPython_EXECUTABLE=$(which python) -DCMAKE_CUDA_FLAGS="-gencode=arch=compute_70,code=sm_70" -DCMAKE_CXX_ABI=1
    make -j 16
    make install
